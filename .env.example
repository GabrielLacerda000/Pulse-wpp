# HTTP server
APP_PORT=3000
APP_HOST=0.0.0.0

# WhatsApp provider ("fake" or "baileys-stub" for now; real "baileys" lands
# in a follow-up ticket)
WHATSAPP_PROVIDER=baileys-stub
WHATSAPP_SESSION_PATH=./sessions

# API auth. PULSE_WPP_API_KEY is canonical; PULSE_API_KEY is accepted as an
# alias per PRD §18/§28/§36.
PULSE_WPP_API_KEY=

# Logging
LOG_LEVEL=info
